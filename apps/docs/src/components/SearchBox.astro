---
/**
 * Recherche statique (index Pagefind), interface maison accessible. Le module Pagefind n'est
 * importé qu'au premier focus ou à la première saisie, jamais au chargement de la page.
 */
import '../styles/search.css';
---

<search>
  <form class="docs-search-form" data-search-form>
    <label class="docs-search-label" for="docs-search-input">
      Rechercher dans la documentation
    </label>
    <input
      class="docs-search-input"
      id="docs-search-input"
      type="search"
      name="q"
      autocomplete="off"
      enterkeyhint="search"
    />
    <button class="docs-search-button" type="submit">
      Rechercher
    </button>
  </form>
  <p class="docs-search-status" role="status" aria-live="polite" data-search-status></p>
  <ol class="docs-search-results" role="list" data-search-results></ol>
</search>

<script>
  import { normalize, summary } from '../lib/search-results';
  import type { RawResult } from '../lib/search-results';

  interface Pagefind {
    search(query: string): Promise<{ results: { data(): Promise<RawResult> }[] }>;
  }

  const DEBOUNCE_MS = 300;
  const MAX_RESULTS = 20;
  const PAGEFIND_URL = '/pagefind/pagefind.js';

  const form = document.querySelector<HTMLFormElement>('[data-search-form]');
  const input = document.querySelector<HTMLInputElement>('#docs-search-input');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const list = document.querySelector<HTMLElement>('[data-search-results]');

  let engine: Promise<Pagefind> | undefined;
  let timer: ReturnType<typeof setTimeout> | undefined;
  let latest = 0;

  const load = (): Promise<Pagefind> =>
    (engine ??= import(/* @vite-ignore */ PAGEFIND_URL) as Promise<Pagefind>);

  function item(result: ReturnType<typeof normalize>): HTMLLIElement {
    const li = document.createElement('li');
    const link = document.createElement('a');
    link.href = result.url;
    link.textContent = result.title;
    const excerpt = document.createElement('p');
    excerpt.innerHTML = result.excerpt; // texte échappé et <mark> seulement (normalize)
    li.append(link, excerpt);
    return li;
  }

  async function run(): Promise<void> {
    if (!input || !status || !list) return;
    const query = input.value.trim();
    const ticket = ++latest;
    if (!query) {
      status.textContent = '';
      list.replaceChildren();
      return;
    }
    try {
      const found = await (await load()).search(query);
      const raw = await Promise.all(found.results.slice(0, MAX_RESULTS).map((r) => r.data()));
      if (ticket !== latest) return;
      list.replaceChildren(...raw.map((r) => item(normalize(r))));
      status.innerHTML = summary(found.results.length, query);
    } catch {
      if (ticket !== latest) return;
      engine = undefined;
      list.replaceChildren();
      status.textContent = 'La recherche est indisponible.';
    }
  }

  function schedule(): void {
    clearTimeout(timer);
    timer = setTimeout(run, DEBOUNCE_MS);
  }

  input?.addEventListener('focus', () => void load().catch(() => (engine = undefined)), {
    once: true,
  });
  input?.addEventListener('input', schedule);
  input?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    event.preventDefault();
    input.value = '';
    clearTimeout(timer);
    void run();
  });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    clearTimeout(timer);
    void run();
  });
</script>
