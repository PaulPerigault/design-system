const CREATE = `npm create @paulperigault mon-site
cd mon-site
git init
npm install
npm run dev`;
const FROM_REPO = `node packages/create/src/infrastructure/bin.ts create mon-site`;
const THEME = `npm create @paulperigault mon-site -- --accent-hue 150 --font-stack "Inter, system-ui, sans-serif"`;
---

