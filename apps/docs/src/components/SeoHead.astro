---
/** Balises SEO du `<head>` : description, canonical, auteur, Open Graph, Twitter, JSON-LD. */
import type { JsonLd } from '../lib/seo.ts';
import { canonicalOf, ogImageOf, serialize } from '../lib/seo.ts';
import { AUTHOR, OG_IMAGE, SITE_LOCALE, SITE_NAME } from '../lib/site.ts';

interface Props {
  title: string;
  description: string;
  pathname: string;
  graphs?: JsonLd[];
}

const { title, description, pathname, graphs = [] } = Astro.props;
const url = canonicalOf(pathname);
---

<meta name="description" content={description} />
<link rel="canonical" href={url} />
<link rel="author" href={AUTHOR.url} />
<meta name="author" content={AUTHOR.name} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:locale" content={SITE_LOCALE} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:image" content={ogImageOf(pathname)} />
<meta property="og:image:width" content={String(OG_IMAGE.width)} />
<meta property="og:image:height" content={String(OG_IMAGE.height)} />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
{graphs.map((data) => (
  <script type="application/ld+json" set:html={serialize(data)} />
))}
