---
/**
 * Encart des textes rédigés à la première personne : brouillons que Paul réécrira à la main.
 * Retirer l'encart (et son import) une fois le texte relu.
 */
import Alert from '@paulperigault/astro/Alert.astro';
---

<Alert tone="degraded" toneLabel="Brouillon à relire par Paul">
  <p>Ce texte est un brouillon. Paul Périgault le relira et le réécrira avant publication.</p>
</Alert>
