---
/** Exemples vivants de la page Card : carte liée, carte sans lien, carte avec pied de carte, carte à marge plus large. */
import Card from '@paulperigault/astro/Card.astro';
import Stack from '@paulperigault/astro/Stack.astro';
---

<Stack space="s">
  <Card title="Design system" href="/utiliser/">
    <p>Jetons, composants Astro et contrôles de qualité, publiés en paquets npm.</p>
  </Card>
  <Card title="Carte sans lien" headingLevel={4}>
    <p>Sans href, la carte n’est pas cliquable et ne reçoit pas le focus.</p>
  </Card>
  <Card title="Carte avec pied" href="/preuves/">
    <p>Le lien du pied de carte reste utilisable au-dessus du lien de la carte.</p>
    <a slot="footer" href="/composants/">
      Astro
    </a>
  </Card>
  <Card title="Marge plus large" density="m" headingLevel={4}>
    <p>
      <code>density="m"</code> passe la marge intérieure de <code>--pp-space-s</code> à{' '}
      <code>--pp-space-m</code>.
    </p>
  </Card>
</Stack>
