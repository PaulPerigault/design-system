---
/**
 * Exemple vivant de la page Milestones3D : un parcours fictif (émetteurs génériques, badges générés
 * par `tools/fixtures/milestones-badges.ts`). Sans JavaScript ni WebGL, la liste complète s'affiche ;
 * sinon le comportement ajoute la scène 3D, pilotée au défilement.
 */
import Milestones3D from '@paulperigault/astro/Milestones3D.astro';
import { DEMO_GOAL, DEMO_MILESTONES } from '../../data/milestones-3d';

const milestones = [...DEMO_MILESTONES];
---

<div class="pp-milestones-demo">
  <h3 id="demo-3d">Parcours de démonstration</h3>
  <p>
    Les jalons sont déclarés dans le désordre : le composant les trie par date. Faites défiler la
    page pour avancer le long du parcours, ou utilisez les étapes, les boutons ou les flèches.
  </p>
  <div data-milestones-demo>
    <Milestones3D
      label="Parcours fictif de certifications"
      milestones={milestones}
      goal={DEMO_GOAL}
    />
  </div>
</div>

<script>
  import { install } from '@paulperigault/astro/milestones-3d';

  const target = document.querySelector('[data-milestones-demo]');
  if (target) install(target);
</script>
