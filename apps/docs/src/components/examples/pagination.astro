---
/** Exemples vivants de la page Pagination : pages avec ellipsis écrite par l'intégrateur, et liste courte. */
import Pagination from '@paulperigault/astro/Pagination.astro';
import Stack from '@paulperigault/astro/Stack.astro';

const middle = [
  { label: '1', href: '#contenu' },
  { label: '5', href: '#contenu' },
  { label: '6', href: '#contenu', current: true },
  { label: '7', href: '#contenu' },
  { label: '12', href: '#contenu' },
];
---

<Stack space="xs">
  <Pagination
    label="Pagination des résultats"
    items={middle}
    previous={{ label: 'Page précédente', href: '#contenu' }}
    next={{ label: 'Page suivante', href: '#contenu' }}
  />
  <Pagination
    label="Pagination courte"
    items={[
      { label: '1', href: '#contenu', current: true },
      { label: '2', href: '#contenu' },
      { label: '3', href: '#contenu' },
    ]}
    next={{ label: 'Page suivante', href: '#contenu' }}
  />
</Stack>
