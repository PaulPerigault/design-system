---
/** Exemples vivants de la page Pagination : pages avec ellipsis écrite par l'intégrateur, et liste courte. */
import Pagination from '@paulperigault/astro/Pagination.astro';
import Stack from '@paulperigault/astro/Stack.astro';

const middle = [
  { label: '1', href: '#page-1' },
  { label: '5', href: '#page-5' },
  { label: '6', href: '#page-6', current: true },
  { label: '7', href: '#page-7' },
  { label: '12', href: '#page-12' },
];
---

<Stack space="xs">
  <Pagination
    label="Pagination des résultats"
    items={middle}
    previous={{ label: 'Page précédente', href: '#page-5' }}
    next={{ label: 'Page suivante', href: '#page-7' }}
  />
  <Pagination
    label="Pagination courte"
    items={[
      { label: '1', href: '#page-1', current: true },
      { label: '2', href: '#page-2' },
      { label: '3', href: '#page-3' },
    ]}
    next={{ label: 'Page suivante', href: '#page-2' }}
  />
</Stack>
