---
/**
 * Menu mobile de la documentation : bouton « Menu » (sous 48 rem) qui ouvre un `Dialog` modal
 * natif avec tous les composants. Piège de focus, Échap et geste retour (demande de fermeture)
 * fournis par le navigateur ; ouverture par Invoker Commands, `InvokerFallback` ailleurs. Sans
 * ces API ni JavaScript, les liens de l'en-tête restent visibles (`styles/header.css`). Les intitulés
 * du panneau sont des `p`, pas des titres : ils ne s'ajoutent pas aux niveaux de la page (audit M-1).
 */
import Dialog from '@paulperigault/astro/Dialog.astro';
import InvokerFallback from '@paulperigault/astro/InvokerFallback.astro';
import { MAIN_LINKS, MORE_LINKS } from '../main-links';
import { GROUPS, hrefOf } from '../navigation';

const MENU_ID = 'docs-menu';
const current = Astro.url.pathname;
---

<button class="docs-menu-button" type="button" commandfor={MENU_ID} command="show-modal">
  Menu
</button>
<InvokerFallback />
<Dialog id={MENU_ID} title="Menu" closeLabel="Fermer">
  {GROUPS.map((group) => (
    <section aria-labelledby={`menu-${group.id}`}>
      <p class="docs-menu-title" id={`menu-${group.id}`}>
        {group.title}
      </p>
      <ul role="list" class="docs-menu-list">
        {group.links.map((link) => (
          <li>
            <a href={hrefOf(link)} aria-current={hrefOf(link) === current ? 'page' : undefined}>
              {link.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <section aria-labelledby="menu-site">
    <p class="docs-menu-title" id="menu-site">
      Site
    </p>
    <ul role="list" class="docs-menu-list">
      {[...MAIN_LINKS, ...MORE_LINKS].map((link) => (
        <li>
          <a href={link.href}>{link.title}</a>
        </li>
      ))}
    </ul>
  </section>
</Dialog>

<style>
  .docs-menu-button {
    min-block-size: var(--pp-size-control-height);
    min-inline-size: var(--pp-size-control-height);
    padding-inline: var(--pp-space-s);
    border: var(--pp-size-rule) solid var(--pp-color-control);
    border-radius: var(--pp-radius-control);
    background-color: transparent;
    color: var(--pp-color-fg);
    font: inherit;
    cursor: pointer;
  }

  /* 48 rem : au-delà, l'en-tête et le sommaire suffisent (pas de var() dans une @media). */
  @media (width >= 48rem) {
    .docs-menu-button {
      display: none;
    }
  }

  .docs-menu-title {
    margin: 0;
    font-weight: var(--pp-font-weight-semibold);
  }

  .docs-menu-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--pp-space-3xs) var(--pp-space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-menu-list a {
    display: flex;
    align-items: center;
    min-block-size: var(--pp-size-control-height);
  }

  .docs-menu-list a[aria-current='page'] {
    font-weight: var(--pp-font-weight-bold);
  }
</style>
