---
import tokens from '@paulperigault/tokens/tokens.json';
import bodyFont from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';
import MobileMenu from '../components/MobileMenu.astro';
import SeoHead from '../components/SeoHead.astro';
import type { JsonLd } from '../lib/seo.ts';
import { AUTHOR } from '../lib/site.ts';
import '../styles/docs.css';
import '../styles/footer.css';
import '../styles/wrap.css';

interface Props {
  title: string;
  description: string;
  /** Graphe JSON-LD propre à la page. */
  jsonLd?: JsonLd;
}

const { title, description, jsonLd } = Astro.props;
const { themeColor } = tokens;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <SeoHead
      title={title}
      description={description}
      pathname={Astro.url.pathname}
      graphs={jsonLd ? [jsonLd] : []}
    />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={bodyFont} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/image/logo.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body>
    <a class="docs-skip" href="#contenu">
      Aller au contenu
    </a>
    <header class="docs-header">
      <a class="docs-brand" href="/">
        Design system @paulperigault
      </a>
      <nav class="docs-nav" aria-label="Principale">
        <a href="/">Accueil</a>
        <a href="/identite/">Identité</a>
        <a href="/composants/#composants">Composants</a>
        <a href="/recherche/">Recherche</a>
      </nav>
      <MobileMenu />
    </header>
    <main id="contenu" class="docs-main" data-pagefind-body>
      <slot />
    </main>
    <footer class="docs-footer">
      <p>
        Design system de paulperigault.fr, licence MIT. Auteur :
        <a href={AUTHOR.url} rel="author">
          Paul Périgault
        </a>
        .
      </p>
      <nav aria-label="Informations">
        <a href="/glossaire/">Glossaire</a>
        <a href="/accessibilite/">Accessibilité</a>
        <a href="/declaration-accessibilite/">Déclaration d’accessibilité</a>
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/confidentialite/">Confidentialité</a>
        <a href="/credits/">Crédits</a>
      </nav>
    </footer>
    <script is:inline type="module" src="/pwa/register.js"></script>
  </body>
</html>
