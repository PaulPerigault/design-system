---
import Accordion from '@paulperigault/astro/Accordion.astro';
import PropsTable from '../../components/PropsTable.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';

const items = [
  { id: 'native', summary: 'Quel élément HTML est utilisé ?', open: true },
  { id: 'keyboard', summary: 'Comment l’utiliser au clavier ?' },
  { id: 'motion', summary: 'Quand l’ouverture est-elle animée ?' },
];

const exclusiveItems = [
  { id: 'one', summary: 'Premier panneau', open: true },
  { id: 'two', summary: 'Deuxième panneau' },
];
---

<DocsLayout title="Accordion · Design system · Paul Perigault">
  <h1>Accordion</h1>
  <p>
    Accordion empile des éléments <code>details</code> et <code>summary</code> natifs. Il ne charge
    aucun JavaScript : le navigateur gère l’état, le clavier et l’annonce aux lecteurs d’écran.
  </p>

  <h2>Panneaux indépendants</h2>
  <Accordion items={items}>
    <p slot="native">
      Un <code>details</code> par panneau, avec un <code>summary</code> pour titre.
    </p>
    <p slot="keyboard">Tab atteint le titre, Entrée ou Espace ouvre et ferme le panneau.</p>
    <p slot="motion">
      Sous <code>prefers-reduced-motion: no-preference</code>, si le navigateur gère
      <code>interpolate-size</code>.
    </p>
  </Accordion>

  <h2>Un seul panneau ouvert</h2>
  <Accordion items={exclusiveItems} exclusive>
    <p slot="one">Ouvrir un autre panneau referme celui-ci.</p>
    <p slot="two">
      L’attribut <code>name</code> est pris en charge depuis 2024 (Baseline). Sans support, les
      panneaux restent indépendants.
    </p>
  </Accordion>

  <h2>Propriétés</h2>
  <PropsTable item="accordion" title="Accordion" />
</DocsLayout>
