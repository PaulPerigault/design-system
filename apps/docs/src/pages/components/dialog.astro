---
import ComponentPage from '../../components/ComponentPage.astro';
import DialogExamples from '../../components/examples/dialog.astro';

const snippet = `<InvokerFallback />
<button type="button" commandfor="confirm" command="show-modal">Supprimer</button>
<Dialog id="confirm" title="Supprimer le brouillon" closeLabel="Annuler">
  <p>Le brouillon sera supprimé.</p>
  <form slot="actions" method="dialog">
    <button type="submit" value="delete">Supprimer</button>
  </form>
</Dialog>`;
---

<ComponentPage
  slug="dialog"
  title="Dialog"
  summary="Dialog ouvre une boîte modale native, sans script, depuis un bouton relié par commandfor."
  use={[
    'Confirmer une action difficile à annuler, comme une suppression.',
    'Bloquer la page derrière jusqu’à une réponse : le reste de la page devient inerte.',
  ]}
  avoid={[
    'Pour une information non bloquante : l’afficher dans la page, sans boîte modale.',
    'Pour un contenu long : une page dédiée se lit mieux qu’une boîte (préférence).',
  ]}
  snippet={snippet}
  a11y={{
    keyboard: [
      'Entrée sur le déclencheur ouvre la boîte.',
      'Échap ferme la boîte, et le focus revient au déclencheur.',
      'Le focus initial va au premier élément focalisable, choisi par le navigateur.',
    ],
    screenReader: [
      'La boîte est nommée par son titre, relié par aria-labelledby.',
      'Le bouton de fermeture porte le libellé closeLabel.',
      'Le rôle dialog est implicite : le composant n’ajoute ni rôle ni aria-modal.',
    ],
    guaranteed: [
      'Élément dialog natif, ouvert par show-modal sans script.',
      'closedby="any" : un clic hors de la boîte la ferme.',
      'Aucun autofocus et aucun attribut style.',
    ],
    integrator: [
      'Fournir un closeLabel traduit et un title précis.',
      'Poser InvokerFallback une fois par page pour les navigateurs sans Invoker Commands.',
      'Donner au déclencheur un nom visible : le composant ne le crée pas.',
    ],
  }}
  evidence={[
    {
      label: 'WCAG 2.1.2 Pas de piège au clavier',
      href: 'https://www.w3.org/WAI/WCAG22/Understanding/no-keyboard-trap.html',
    },
    {
      label: 'WCAG 4.1.2 Nom, rôle, valeur',
      href: 'https://www.w3.org/WAI/WCAG22/Understanding/name-role-value.html',
    },
    { label: 'Tests : packages/astro/test/Dialog.test.ts' },
    { label: 'Tests e2e : apps/docs/e2e/dialog.spec.ts' },
  ]}
>
  <DialogExamples />
</ComponentPage>
