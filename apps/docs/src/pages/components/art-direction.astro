---
import ArtDirection from '@paulperigault/astro/ArtDirection.astro';
import PropsTable from '../../components/PropsTable.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import large from '../../assets/media/large.jpg';
import largeEtroit from '../../assets/media/large-etroit.jpg';
---

<DocsLayout title="ArtDirection · Design system · Paul Perigault">
  <h1>ArtDirection</h1>
  <p>
    ArtDirection sert un recadrage resserré sur le sujet aux écrans étroits au lieu de réduire
    l’image large : chaque source porte les dimensions de son recadrage, la place est réservée avant
    le chargement.
  </p>

  <h2>Recadrage étroit sous la mesure</h2>
  <ArtDirection
    src={large}
    sources={[{ at: 'narrow', src: largeEtroit }]}
    alt="Composition géométrique : disque bleu et colonne grise au-dessus d’une bande d’horizon"
    priority
  />

  <h2>Propriétés</h2>
  <PropsTable item="art-direction" title="ArtDirection" />
</DocsLayout>
