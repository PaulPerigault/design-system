---
import Switcher from '@paulperigault/astro/Switcher.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Switcher · Design system · Paul Perigault">
  <h1>Switcher</h1>
  <p>
    Switcher place ses enfants côte à côte quand la largeur disponible dépasse le seuil choisi, puis
    les empile en dessous, sans media query ni JavaScript.
  </p>

  <h2>Seuil par défaut (measure)</h2>
  <Switcher>
    <p>Premier bloc.</p>
    <p>Deuxième bloc.</p>
    <p>Troisième bloc.</p>
  </Switcher>

  <h2>Seuil page, espacement large</h2>
  <Switcher threshold="page" space="l" as="section">
    <p>Premier bloc.</p>
    <p>Deuxième bloc.</p>
  </Switcher>

  <h2>Propriétés</h2>
  <table>
    <thead>
      <tr>
        <th scope="col">Propriété</th>
        <th scope="col">Valeurs</th>
        <th scope="col">Défaut</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">
          <code>threshold</code>
        </th>
        <td>
          <code>measure</code>, <code>page</code>
        </td>
        <td>
          <code>measure</code>
        </td>
      </tr>
      <tr>
        <th scope="row">
          <code>space</code>
        </th>
        <td>
          <code>xs</code>, <code>s</code>, <code>m</code>, <code>l</code>, <code>xl</code>
        </td>
        <td>
          <code>m</code>
        </td>
      </tr>
      <tr>
        <th scope="row">
          <code>as</code>
        </th>
        <td>
          <code>div</code>, <code>section</code>, <code>ul</code>, <code>ol</code>,
          <code>article</code>
        </td>
        <td>
          <code>div</code>
        </td>
      </tr>
      <tr>
        <th scope="row">
          <code>class</code>
        </th>
        <td>placement dans le parent uniquement</td>
        <td>aucun</td>
      </tr>
    </tbody>
  </table>
</DocsLayout>
