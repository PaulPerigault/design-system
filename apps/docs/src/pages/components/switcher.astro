---
import ComponentPage from '../../components/ComponentPage.astro';
import Examples from '../../components/examples/switcher.astro';

const snippet = `<Switcher threshold="page" space="l" as="section">
  <p>Premier bloc.</p>
  <p>Deuxième bloc.</p>
</Switcher>`;
---

<ComponentPage
  slug="switcher"
  title="Switcher"
  summary="Switcher place ses enfants côte à côte au-delà d’un seuil de largeur, puis les empile en dessous."
  use={[
    'Regrouper deux ou trois blocs qui se lisent mieux côte à côte sur un grand écran.',
    'Changer la disposition selon la largeur du conteneur, sans media query ni JavaScript.',
  ]}
  avoid={[
    'Pour une disposition en grille à colonnes régulières : utiliser Grid.',
    'Pour changer l’ordre visuel des blocs : le composant ne réordonne pas, il suit l’ordre du DOM.',
  ]}
  snippet={snippet}
  a11y={{
    keyboard: [
      'Le composant n’ajoute aucun élément interactif : Tab ne s’y arrête pas.',
      'L’ordre de tabulation suit l’ordre du DOM, car aucune propriété order n’est utilisée.',
    ],
    screenReader: [
      'Le composant ne pose aucun rôle : les enfants sont lus dans l’ordre du DOM.',
      'Avec as="ul" ou as="ol", les enfants doivent être des li.',
    ],
    guaranteed: [
      'L’ordre visuel est celui du DOM, quel que soit le seuil (Switcher.astro, aucun order).',
      'Retour à la ligne en CSS pur, sans JavaScript ni style en ligne (Switcher.test.ts).',
    ],
    integrator: [
      'Vérifier que l’ordre du DOM se lit bien quand les blocs passent sur plusieurs lignes.',
      'Avec as="ul" ou as="ol", tester la sémantique de liste : display: flex peut la retirer.',
      'Tester à la largeur réelle du conteneur, pas seulement à la largeur de la fenêtre.',
    ],
  }}
  evidence={[
    {
      label: 'WCAG 1.3.2 Ordre de lecture signifié (Meaningful Sequence)',
      href: 'https://www.w3.org/WCAG22/Understanding/meaningful-sequence.html',
    },
    {
      label:
        'WCAG 1.4.10 Reflow : layout.spec.ts vérifie flex-wrap: wrap, pas la largeur de 320 px',
      href: 'https://www.w3.org/WCAG22/Understanding/reflow.html',
    },
    { label: 'Tests : packages/astro/test/Switcher.test.ts ; apps/docs/e2e/layout.spec.ts' },
    { label: 'Code source : packages/astro/src/layout/Switcher.astro' },
  ]}
>
  <Examples />
</ComponentPage>
