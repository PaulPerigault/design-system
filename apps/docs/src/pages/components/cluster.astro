---
import Cluster from '@paulperigault/astro/Cluster.astro';
import PropsTable from '../../components/PropsTable.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Cluster · Design system · Paul Perigault">
  <h1>Cluster</h1>
  <p>
    Cluster aligne ses enfants sur une ligne, les fait passer à la suivante quand la place manque et
    garde le même écart entre eux dans les deux axes.
  </p>

  <h2>Liste d’étiquettes</h2>
  <Cluster as="ul" space="m">
    <li>Accessibilité</li>
    <li>Typographie</li>
    <li>Performance</li>
    <li>Impression</li>
  </Cluster>

  <h2>Navigation centrée</h2>
  <Cluster as="nav" label="Liens de l’exemple Cluster" justify="center" space="l">
    <a href="#accessibilite">Accessibilité</a>
    <a href="#typographie">Typographie</a>
    <a href="#performance">Performance</a>
  </Cluster>

  <h2>Propriétés</h2>
  <PropsTable item="cluster" title="Cluster" />
</DocsLayout>
