---
import ComponentPage from '../../components/ComponentPage.astro';
import Milestones3DLoading from '../../components/Milestones3DLoading.astro';
import Milestones3DSecurity from '../../components/Milestones3DSecurity.astro';
import Milestones3DExamples from '../../components/examples/milestones-3d.astro';
import { EXTRA_SECTIONS } from '../../data/milestones-3d';

const snippet = `---
import Milestones3D from '@paulperigault/astro/Milestones3D.astro';
---
<Milestones3D
  label="Feuille de route"
  milestones={[
    { id: 'proto', label: 'Prototype', status: 'achieved', date: '2025-03' },
    { id: 'v1', label: 'Version 1', status: 'planned', date: '2026-06' },
  ]}
  goal={{ label: 'Ouverture au public' }}
/>

<script>
  import { install } from '@paulperigault/astro/milestones-3d';
  install(document);
</script>`;
---

<ComponentPage
  slug="milestones-3d"
  title="Milestones3D"
  summary="Milestones3D présente des jalons le long d’un parcours : une liste ordonnée complète, à laquelle une scène 3D WebGL2 peut s’ajouter."
  use={[
    'Montrer un parcours, une feuille de route ou une suite de réalisations, avec des jalons atteints et des jalons prévus.',
    'Offrir une présentation plus visuelle sans perdre le texte : la liste reste la source de vérité.',
  ]}
  avoid={[
    'Pour une simple chronologie datée : utiliser Timeline, sans JavaScript ni WebAssembly.',
    'Pour un contenu qui n’existerait que dans la scène : le canvas ne porte aucun texte et reste masqué aux lecteurs d’écran.',
    'Au-delà de 24 jalons : la scène refuse, la liste seule s’affiche.',
  ]}
  snippet={snippet}
  extra={EXTRA_SECTIONS}
  a11y={{
    keyboard: [
      'Sans 3D, la liste n’a que des liens : Tab les parcourt dans l’ordre des jalons.',
      'Avec la 3D, chaque libellé devient un bouton (`aria-pressed`) ; Entrée ou Espace choisit le jalon et met le panneau de détail à jour.',
      'Le canvas est hors de l’ordre de tabulation (`tabindex="-1"`) : tout se fait par la liste.',
    ],
    screenReader: [
      'La liste est annoncée comme liste, avec le nombre de jalons ; le statut est écrit (« Atteint », « Prévu »).',
      'Le canvas est `aria-hidden="true"` : il ne porte aucun texte qui ne soit pas écrit dans la liste (WCAG 1.1.1).',
      'Le panneau de détail est une région nommée en `aria-live="polite"` : le jalon choisi y est annoncé.',
    ],
    guaranteed: [
      'La liste n’est jamais retirée ni masquée, avec ou sans 3D (WCAG 1.3.1).',
      'Le statut est écrit en toutes lettres, doublé d’un trait plein ou pointillé : la forme seule ne porte pas le sens (WCAG 1.4.1).',
      'Aucun mouvement ne démarre seul : pas de pause à offrir (WCAG 2.2.2). Le mouvement déclenché par un geste est supprimé sous `prefers-reduced-motion`, avec la 3D entière (WCAG 2.3.3, niveau AAA, retenu par prudence).',
      'Liens et boutons ont une cible d’au moins `--pp-size-target-min` (WCAG 2.5.8).',
    ],
    integrator: [
      'Fournir des libellés, dates et liens complets : la scène n’ajoute aucune information.',
      'Passer `locale` (langue des dates) et `labels` (mots d’interface) dans la langue de la page.',
      'Donner un `label` quand la page porte plusieurs parcours.',
      'Vérifier le contraste du texte de vos données sur le fond de votre page : le composant n’impose pas de fond.',
    ],
  }}
  evidence={[
    { label: 'ADR-0012 : scène 3D de jalons', href: '/decisions/0012/' },
    {
      label: 'WCAG 2.2.2 Pause, Stop, Hide',
      href: 'https://www.w3.org/WAI/WCAG22/Understanding/pause-stop-hide',
    },
    {
      label: 'WCAG 2.3.3 Animation from Interactions',
      href: 'https://w3c.github.io/wcag/understanding/animation-from-interactions',
    },
    {
      label: 'Khronos : perte de contexte WebGL',
      href: 'https://wikis.khronos.org/webgl/HandlingContextLost',
    },
    {
      label: 'Tests : packages/astro/test/Milestones3D.test.ts et milestones-3d.behavior.test.ts',
    },
  ]}
>
  <Milestones3DExamples />
  <Fragment slot="more">
    <Milestones3DLoading />
    <Milestones3DSecurity />
  </Fragment>
</ComponentPage>
