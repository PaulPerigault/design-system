---
import ComponentPage from '../../components/ComponentPage.astro';
import SiteHeaderExamples from '../../components/examples/site-header.astro';
import SiteHeaderVariants from '../../components/examples/site-header-variantes.astro';

const snippet = `<!-- Recette : barre à 4 entrées, menu replié à 8, action aussi dans le menu, seuil à 75 rem -->
<SiteHeader layout="inline" expandAt={75}>
  <a slot="signature" href="/">Atelier</a>
  <SiteMenu
    slot="navigation"
    label="Navigation"
    summary="Menu"
    items={allItems}
    barItems={allItems.slice(0, 4)}
  >
    <Button block href="/rdv/">Rendez-vous</Button>
  </SiteMenu>
  <Button slot="action" tone="secondary" href="/rdv/">Rendez-vous</Button>
</SiteHeader>

/* Marges de marque, posées sur un ancêtre */
:root {
  --pp-site-header-padding-block: var(--pp-space-xs);
  --pp-site-header-padding-inline: var(--pp-space-m);
}`;
---

<ComponentPage
  slug="site-header"
  title="SiteHeader"
  summary="SiteHeader range la signature, la navigation et l’action d’un site dans un en-tête qui tient sur une rangée dès 48 rem ; le seuil d’apparition de l’action et de dépliage du menu se règle."
  use={[
    'Poser l’en-tête d’un site : une signature, un SiteMenu ou un SiteNav, une action.',
    'Composer sans JavaScript : le repli vient de SiteMenu.',
  ]}
  avoid={[
    'Pour la navigation seule : utiliser SiteNav ou SiteMenu.',
    'Pour un en-tête de page ou de section : un titre suffit.',
  ]}
  snippet={snippet}
  a11y={{
    keyboard: [
      'Les liens et le bouton se parcourent avec Tab, dans l’ordre du document : signature, navigation, action.',
      'Le bouton « Menu » s’ouvre avec Entrée et Espace (voir SiteMenu).',
    ],
    screenReader: [
      'Le composant rend un élément header ; la navigation garde le nom de son repère nav.',
      'Un slot vide ne rend aucun élément.',
    ],
    guaranteed: [
      'Chaque zone fait au moins --pp-size-control-height de haut.',
      'Étroit, l’action est masquée : la mettre aussi dans le slot de SiteMenu.',
      'Zéro JavaScript ; le seuil est une requête de conteneur en rem, il suit le zoom du texte.',
      '`expandAt` (48, 56, 64 ou 75 rem) règle d’une seule valeur l’apparition de l’action et le dépliage du `SiteMenu` de l’en-tête.',
    ],
    integrator: [
      'Donner un nom distinct à chaque repère nav de la page (critère 2.4.1).',
      'Le conteneur prend la largeur de son parent : placer l’en-tête dans un élément de pleine largeur, jamais dans un parent flex ou grille qui le dimensionne selon son contenu.',
      '`layout="inline"` garde la signature et le bouton de menu sur une rangée ; le panneau ouvert se pose sous l’en-tête, sur toute sa largeur.',
      '`--pp-site-header-padding-block` et `-inline` règlent les marges (défauts : `--pp-space-3xs` et `--pp-space-s`).',
      'Le lien de la signature mène à l’accueil.',
    ],
  }}
  evidence={[
    {
      label: 'WCAG 1.4.10 Redistribution du contenu',
      href: 'https://www.w3.org/WAI/WCAG22/Understanding/reflow.html',
    },
    { label: 'Tests : packages/astro/test/SiteHeader.test.ts, apps/docs/e2e/site-header.spec.ts' },
  ]}
>
  <SiteHeaderExamples />
  <Fragment slot="variants">
    <SiteHeaderVariants />
  </Fragment>
</ComponentPage>
