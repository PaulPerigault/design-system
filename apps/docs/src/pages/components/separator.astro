---
import Separator from '../../../../../packages/astro/src/content/Separator.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';

const props = [
  ['decorative', 'boolean', 'false', 'Rend un <hr> sémantique (false) ou décoratif (true).'],
  ['space', "'xs' | 's' | 'm' | 'l' | 'xl'", 'm', 'Espacement vertical autour du filet.'],
  ['class', 'string', 'aucun', 'Réservé au placement dans le parent.'],
];
---

<DocsLayout title="Separator · Design system · Paul Perigault">
  <h1>Separator</h1>
  <p>
    Separator rend un filet horizontal de décoration ou de séparation. Par défaut, il s’agit d’un `
    <hr />` natif avec sémantique ( WCAG 2.2 AA). Quand `decorative` est true, le séparateur est
    décoratif (`role="presentation"`, `aria-hidden="true"`), sans incidence sur l’accessibilité.
  </p>

  <h2>Défaut</h2>
  <p>
    Un séparateur sémantique pour distinguer deux sections :
    <Separator />
  </p>

  <h2>Décoratif</h2>
  <p>
    Un séparateur décoratif entre deux éléments visuels :
    <Separator decorative />
  </p>

  <h2>Variantes d’espacement</h2>
  <p>
    <Separator space="xs" />
    <Separator space="s" />
    <Separator space="m" />
    <Separator space="l" />
    <Separator space="xl" />
  </p>

  <h2>Propriétés</h2>
  <table>
    <caption>Propriétés de Separator</caption>
    <thead>
      <tr>
        <th scope="col">Nom</th>
        <th scope="col">Type</th>
        <th scope="col">Défaut</th>
        <th scope="col">Rôle</th>
      </tr>
    </thead>
    <tbody>
      {props.map(([name, type, byDefault, role]) => (
        <tr>
          <th scope="row">
            <code>{name}</code>
          </th>
          <td>
            <code>{type}</code>
          </td>
          <td>{byDefault}</td>
          <td>{role}</td>
        </tr>
      ))}
    </tbody>
  </table>
</DocsLayout>
