---
import Separator from '@paulperigault/astro/Separator.astro';
import Table from '@paulperigault/astro/Table.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';

const columns = [
  { key: 'name', label: 'Nom' },
  { key: 'type', label: 'Type' },
  { key: 'fallback', label: 'Défaut' },
  { key: 'role', label: 'Rôle' },
];
const rows = [
  {
    name: 'decorative',
    type: 'boolean',
    fallback: 'false',
    role: 'false : hr lu comme séparateur ; true : masqué aux technologies d’assistance.',
  },
  {
    name: 'space',
    type: "'xs' | 's' | 'm' | 'l' | 'xl'",
    fallback: "'m'",
    role: 'Espacement autour du filet.',
  },
  { name: 'class', type: 'string', fallback: 'aucun', role: 'Placement dans le parent.' },
];
---

<DocsLayout title="Separator · Design system · Paul Perigault">
  <h1>Separator</h1>
  <p>
    Separator rend un élément hr natif, lu comme séparateur entre deux sections ; avec decorative,
    le filet est masqué aux technologies d’assistance (role="presentation", aria-hidden).
  </p>

  <h2>Entre deux sections</h2>
  <div>
    <p>Fin de la première section.</p>
    <Separator />
    <p>Début de la seconde section.</p>
  </div>

  <h2>Décoratif</h2>
  <div>
    <p>Filet purement visuel.</p>
    <Separator decorative />
  </div>

  <h2>Espacements</h2>
  <div>
    <Separator space="xs" />
    <Separator space="s" />
    <Separator space="m" />
    <Separator space="l" />
    <Separator space="xl" />
  </div>

  <h2>Propriétés</h2>
  <Table caption="Propriétés de Separator" columns={columns} rows={rows} rowHeader="name" />
</DocsLayout>
