---
import Separator from '@paulperigault/astro/Separator.astro';
import PropsTable from '../../components/PropsTable.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Separator · Design system · Paul Perigault">
  <h1>Separator</h1>
  <p>
    Separator rend un élément hr natif, lu comme séparateur entre deux sections ; avec decorative,
    le filet est masqué aux technologies d’assistance (role="presentation", aria-hidden).
  </p>

  <h2>Entre deux sections</h2>
  <div>
    <p>Fin de la première section.</p>
    <Separator />
    <p>Début de la seconde section.</p>
  </div>

  <h2>Décoratif</h2>
  <div>
    <p>Filet purement visuel.</p>
    <Separator decorative />
  </div>

  <h2>Espacements</h2>
  <div>
    <Separator space="xs" />
    <Separator space="s" />
    <Separator space="m" />
    <Separator space="l" />
    <Separator space="xl" />
  </div>

  <h2>Propriétés</h2>
  <PropsTable item="separator" title="Separator" />
</DocsLayout>
