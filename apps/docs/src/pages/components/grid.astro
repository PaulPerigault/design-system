---
import Grid from '@paulperigault/astro/Grid.astro';
import PropsTable from '../../components/PropsTable.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Grid · Design system · Paul Perigault">
  <h1>Grid</h1>
  <p>
    Grid répartit ses enfants en colonnes de largeur minimale donnée : le nombre de colonnes
    s’adapte à la place disponible, sans media query.
  </p>

  <h2>Largeur minimale par défaut</h2>
  <Grid as="ul">
    <li>Premier élément</li>
    <li>Deuxième élément</li>
    <li>Troisième élément</li>
  </Grid>

  <h2>Colonnes étroites, espacement large</h2>
  <Grid as="section" min="narrow" space="l">
    <p>Premier bloc.</p>
    <p>Deuxième bloc.</p>
    <p>Troisième bloc.</p>
    <p>Quatrième bloc.</p>
  </Grid>

  <h2>Propriétés</h2>
  <PropsTable item="grid" title="Grid" />
</DocsLayout>
