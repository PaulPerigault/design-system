---
import { oklchToSrgb, parseOklch } from '@paulperigault/tokens/color';
import tokens from '@paulperigault/tokens/tokens.json';
import Photo from '@paulperigault/astro/Photo.astro';
import Scrim from '@paulperigault/astro/Scrim.astro';
import { worstCaseContrast } from '@paulperigault/astro/scrim';
import PropsTable from '../../components/PropsTable.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import paysage from '../../assets/media/paysage.jpg';

const base: Record<string, string> = tokens.base;
const rgb = (name: string) => oklchToSrgb(parseOklch(base[name] ?? ''));
const worst = worstCaseContrast({
  veil: rgb('--pp-media-scrim-color'),
  opacity: Number(base['--pp-media-scrim-opacity']),
  text: rgb('--pp-media-scrim-text'),
}).toLocaleString('fr-FR', { maximumFractionDigits: 1 });
---

<DocsLayout title="Scrim · Design system · Paul Perigault">
  <h1>Scrim</h1>
  <p>
    Scrim pose le texte sur un voile uni semi-opaque : quelle que soit l’image dessous, le contraste
    du texte vaut au moins {worst}:1, valeur calculée au build depuis les tokens.
  </p>

  <h2>Texte en bas de l’image</h2>
  <Scrim>
    <Photo slot="media" src={paysage} decorative ratio="landscape" />
    <p>
      <strong>Soleil sur bandes</strong>
    </p>
    <p>Voile uni, sans dégradé ni flou.</p>
  </Scrim>

  <h2>Propriétés</h2>
  <PropsTable item="scrim" title="Scrim" />
</DocsLayout>
