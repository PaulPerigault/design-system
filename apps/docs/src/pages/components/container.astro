---
import Container from '@paulperigault/astro/Container.astro';
import PropsTable from '../../components/PropsTable.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Container · Design system · Paul Perigault">
  <h1>Container</h1>
  <p>
    Container centre son contenu dans l’axe d’inline, limite sa largeur à la largeur de page ou à la
    mesure de lecture, et réserve une gouttière de chaque côté.
  </p>

  <h2>Largeur de page</h2>
  <Container as="section" width="page" gutter="m">
    <p>Contenu à la largeur de page, gouttière moyenne.</p>
  </Container>

  <h2>Mesure de lecture</h2>
  <Container as="article" width="measure" gutter="l">
    <p>Contenu limité à la mesure de lecture, gouttière large.</p>
  </Container>

  <h2>Propriétés</h2>
  <PropsTable item="container" title="Container" />
</DocsLayout>
