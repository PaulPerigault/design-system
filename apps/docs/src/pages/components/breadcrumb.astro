---
import Breadcrumb from '@paulperigault/astro/Breadcrumb.astro';
import PropsTable from '../../components/PropsTable.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';

const items = [
  { href: '/', label: 'Accueil' },
  { href: '/components/', label: 'Composants' },
  { label: 'Breadcrumb' },
];
---

<DocsLayout title="Breadcrumb · Design system · Paul Perigault">
  <h1>Breadcrumb</h1>
  <p>
    Breadcrumb indique l’emplacement de la page dans la hiérarchie du site. La page courante est le
    dernier élément : elle n’est pas un lien et porte <code>aria-current="page"</code>.
  </p>

  <h2>Exemple</h2>
  <Breadcrumb label="Fil d’Ariane de l’exemple" items={items} />

  <h2>Accessibilité</h2>
  <ul>
    <li>
      Repère <code>nav</code> nommé par <code>label</code>, liste <code>ol</code> avec{' '}
      <code>role="list"</code>.
    </li>
    <li>
      Les séparateurs sont générés en CSS avec un texte alternatif vide : les lecteurs d’écran ne
      les annoncent pas.
    </li>
    <li>
      Les liens sont soulignés, la page courante est en graisse moyenne : pas de couleur seule.
    </li>
  </ul>

  <h2>Propriétés</h2>
  <PropsTable item="breadcrumb" title="Breadcrumb" />
</DocsLayout>
