---
import Center from '@paulperigault/astro/Center.astro';
import PropsTable from '../../components/PropsTable.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Center · Design system · Paul Perigault">
  <h1>Center</h1>
  <p>
    Center centre un bloc dans l’axe inline et limite sa largeur à la mesure de lecture définie par
    le token <code>--pp-size-measure</code>.
  </p>

  <h2>Texte centré avec marge latérale</h2>
  <Center text gutter="m" as="section">
    <p>Ce paragraphe est centré, avec une marge latérale de taille m.</p>
  </Center>

  <h2>Enfants centrés selon leur largeur propre</h2>
  <Center intrinsic gutter="s">
    <p>Un premier paragraphe court.</p>
    <button type="button">Action</button>
  </Center>

  <h2>Propriétés</h2>
  <PropsTable item="center" title="Center" />
</DocsLayout>
