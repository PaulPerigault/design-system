---
import Progress from '@paulperigault/astro/Progress.astro';
import Stack from '@paulperigault/astro/Stack.astro';
import PropsTable from '../../components/PropsTable.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Progress · Design system · Paul Perigault">
  <h1>Progress</h1>
  <p>
    Progress rend un élément natif : progress pour un avancement, meter pour une mesure dans une
    plage connue. Le libellé est relié par label for, la valeur s’affiche en texte : elle ne dépend
    jamais de la couleur seule.
  </p>
  <Stack space="m">
    <h2>Avancement</h2>
    <Progress id="demo-progress" label="Envoi du fichier" value={3} max={5} valueText="3 sur 5" />
    <h2>Indéterminé</h2>
    <Progress id="demo-indeterminate" label="Préparation de l’archive" />
    <h2>Mesure</h2>
    <Progress
      id="demo-meter"
      kind="meter"
      label="Espace disque utilisé"
      value={0.9}
      low={0.5}
      high={0.8}
      optimum={0.2}
      valueText="90 %"
    />
    <h2>Propriétés</h2>
    <PropsTable item="progress" title="Progress" />
  </Stack>
</DocsLayout>
