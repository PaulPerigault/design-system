---
import Button from '../../../../../packages/astro/src/forms/Button.astro';
import PropsTable from '../../components/PropsTable.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Button · Design system · Paul Perigault">
  <h1>Button</h1>
  <p>
    Button rend un bouton natif, ou un lien si href est fourni : un bouton déclenche une action, un
    lien mène à une adresse. Le libellé vient du contenu du composant.
  </p>

  <h2>Défaut</h2>
  <p>
    <Button type="submit">Envoyer</Button>
    <Button tone="secondary">Annuler</Button>
    <Button tone="quiet">Plus tard</Button>
    <Button href="/">Retour à l’accueil</Button>
  </p>

  <h2>Erreur</h2>
  <p id="button-erreur" role="alert">
    L’envoi a échoué. Vérifiez la connexion puis réessayez.
  </p>
  <p>
    <Button tone="secondary" type="submit">
      Réessayer
    </Button>
  </p>

  <h2>Désactivé</h2>
  <p>
    <Button disabled>Envoyer</Button>
    <Button href="/" disabled>
      Lien désactivé
    </Button>
  </p>

  <h2>Propriétés</h2>
  <PropsTable item="button" title="Button" />
</DocsLayout>
