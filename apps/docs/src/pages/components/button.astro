---
import Button from '../../../../../packages/astro/src/forms/Button.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';

const props = [
  ['tone', "'primary' | 'secondary' | 'quiet'", 'primary', 'Fond accent, bordure, ou souligné.'],
  ['size', "'m' | 'l'", 'm', 'Taille du texte et de l’espacement interne.'],
  ['type', "'button' | 'submit' | 'reset'", 'button', 'Type du bouton natif.'],
  ['disabled', 'boolean', 'false', 'Lien : sans href, aria-disabled="true".'],
  ['href', 'string', 'aucun', 'Rend un lien <a> avec les mêmes classes.'],
  ['class', 'string', 'aucun', 'Réservé au placement dans le parent.'],
];
---

<DocsLayout title="Button · Design system · Paul Perigault">
  <h1>Button</h1>
  <p>
    Button rend un bouton natif, ou un lien si href est fourni : un bouton déclenche une action, un
    lien mène à une adresse. Le libellé vient du contenu du composant.
  </p>

  <h2>Défaut</h2>
  <p>
    <Button type="submit">Envoyer</Button>
    <Button tone="secondary">Annuler</Button>
    <Button tone="quiet">Plus tard</Button>
    <Button href="/">Retour à l’accueil</Button>
  </p>

  <h2>Erreur</h2>
  <p id="button-erreur" role="alert">
    L’envoi a échoué. Vérifiez la connexion puis réessayez.
  </p>
  <p>
    <Button tone="secondary" type="submit">
      Réessayer
    </Button>
  </p>

  <h2>Désactivé</h2>
  <p>
    <Button disabled>Envoyer</Button>
    <Button href="/" disabled>
      Lien désactivé
    </Button>
  </p>

  <h2>Propriétés</h2>
  <table>
    <caption>Propriétés de Button</caption>
    <thead>
      <tr>
        <th scope="col">Nom</th>
        <th scope="col">Type</th>
        <th scope="col">Défaut</th>
        <th scope="col">Rôle</th>
      </tr>
    </thead>
    <tbody>
      {props.map(([name, type, byDefault, role]) => (
        <tr>
          <th scope="row">
            <code>{name}</code>
          </th>
          <td>
            <code>{type}</code>
          </td>
          <td>{byDefault}</td>
          <td>{role}</td>
        </tr>
      ))}
    </tbody>
  </table>
</DocsLayout>
