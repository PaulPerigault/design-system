---
import Status from '@paulperigault/astro/Status.astro';
import PropsTable from '../../components/PropsTable.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Status · Design system · Paul Perigault">
  <h1>Status</h1>
  <p>
    Status indique l’état d’un pipeline par un libellé écrit et une icône de forme propre à chaque
    état. La couleur renforce l’icône ; elle ne porte jamais l’information seule.
  </p>

  <h2>Les quatre états</h2>
  <ul role="list">
    <li>
      <Status state="passed" label="Réussi" />
    </li>
    <li>
      <Status state="failed" label="Échec" />
    </li>
    <li>
      <Status state="degraded" label="Dégradé" />
    </li>
    <li>
      <Status state="running" label="En cours" />
    </li>
  </ul>

  <h2>Identifiant en police mono</h2>
  <p>
    <Status state="passed" label="3f9c2ab" mono />
  </p>

  <h2>Propriétés</h2>
  <PropsTable item="status" title="Status" />
</DocsLayout>
