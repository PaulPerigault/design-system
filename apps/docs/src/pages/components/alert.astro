---
import ComponentPage from '../../components/ComponentPage.astro';
import AlertExamples from '../../components/examples/alert.astro';

const snippet = `<Alert tone="failed" toneLabel="Échec" title="Contrôle de taille" live="polite">
  <p>Un fichier dépasse 120 lignes.</p>
</Alert>`;
---

<ComponentPage
  slug="alert"
  title="Alert"
  summary="Alert met un message en avant, avec un ton écrit en clair et une annonce optionnelle."
  use={[
    'Signaler un résultat, un avertissement ou une information qui doit être lu avec la page.',
    'Annoncer un message inséré après le chargement, avec live="polite" ou live="assertive".',
  ]}
  avoid={[
    'Pour un message ajouté après le chargement sans live : aucun rôle n’est posé, rien n’est annoncé.',
    'Pour une action à confirmer : préférence pour Dialog.',
  ]}
  snippet={snippet}
  a11y={{
    keyboard: [
      'Le composant n’est pas interactif : il ne prend pas le focus.',
      'Un lien ou un bouton placé dans l’alerte se parcourt avec Tab.',
    ],
    screenReader: [
      'Sans live, aucun rôle : le message est lu dans le flux de la page.',
      'live="polite" donne role="status" ; live="assertive" donne role="alert", qui interrompt.',
      'L’icône est masquée (aria-hidden) : le ton est lu par toneLabel.',
    ],
    guaranteed: [
      'L’icône est décorative : aria-hidden="true" et focusable="false".',
      'Le ton est écrit en clair : la couleur ne porte jamais seule l’information.',
      'En forced-colors, le filet et l’icône passent en CanvasText.',
    ],
    integrator: [
      'Écrire toneLabel dans la langue de la page.',
      'Poser live seulement sur un message ajouté après le chargement.',
      'Garder le titre et le corps lisibles sans la couleur.',
    ],
  }}
  evidence={[
    {
      label: 'WCAG 1.1.1 Contenu non textuel, niveau A',
      href: 'https://www.w3.org/TR/WCAG22/#non-text-content',
    },
    {
      label: 'WCAG 1.4.1 Utilisation de la couleur, niveau A',
      href: 'https://www.w3.org/TR/WCAG22/#use-of-color',
    },
    {
      label: 'WCAG 4.1.3 Messages d’état, niveau AA : rôles status et alert, dans Alert.test.ts',
      href: 'https://www.w3.org/TR/WCAG22/#status-messages',
    },
    { label: 'Tests unitaires : packages/astro/test/Alert.test.ts' },
    { label: 'Code source : packages/astro/src/feedback/Alert.astro' },
  ]}
>
  <AlertExamples />
</ComponentPage>
