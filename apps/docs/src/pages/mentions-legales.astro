---
import process from 'node:process';
import DocsLayout from '../layouts/DocsLayout.astro';
import { LEGAL, assertProductionReady } from '../lib/legal.ts';

// Refuse la compilation de production si l'hébergeur ou le contact manquent (LCEN, article 1-1).
assertProductionReady(LEGAL, process.env);

const pending = (value: string): string => value || 'à compléter';
---

<DocsLayout
  title="Mentions légales · Design system · Paul Perigault"
  description="Mentions légales du design system : éditeur, directeur de la publication, hébergeur, contact et licences du code et des contenus."
>
  <div class="docs-prose">
    <h1>Mentions légales</h1>

    <h2>Éditeur</h2>
    <p>
      Le site est édité par {LEGAL.publisher}, personne physique, à titre non professionnel. Il ne
      rapporte aucun revenu. L’éditeur agit sous sa responsabilité et a communiqué son identité à
      l’hébergeur.
    </p>
    <p>
      Il applique l’
      <a href="https://www.legifrance.gouv.fr/loda/article_lc/LEGIARTI000049568614">
        article 1-1, II, de la loi 2004-575
      </a>{' '}
      (lu le 4 novembre 2026) : un éditeur non professionnel peut ne rendre public que le nom et
      l’adresse de son hébergeur. Aucun domicile ni téléphone personnel n’est publié. La loi ne
      définit pas « non professionnel » : cette qualification n’est pas établie juridiquement.
    </p>
    <p>Contact : {pending(LEGAL.contact)}</p>

    <h2>Directeur de la publication</h2>
    <p>Le directeur de la publication est {LEGAL.publisher}.</p>

    <h2>Hébergeur</h2>
    <p>Hébergeur : {pending(LEGAL.host)}</p>
    <p>
      Adresse et téléphone lus le 4 novembre 2026 sur la{' '}
      <a href="https://www.cloudflare.com/privacypolicy/">
        politique de confidentialité de Cloudflare
      </a>
      . Téléphone de l’hébergeur : +1 (650) 319-8930.
    </p>

    <h2>Propriété intellectuelle</h2>
    <p>
      Les textes et l’identité visuelle du site sont {LEGAL.licenseContent}. Le code des paquets est
      publié sous licence {LEGAL.licenseCode} ; le texte de la licence est dans le fichier LICENSE
      du dépôt. Les polices et les outils tiers sont listés sur la page{' '}
      <a href="/credits/">Crédits</a>.
    </p>

    <h2>Données personnelles</h2>
    <p>
      Le traitement des données personnelles est décrit sur la page{' '}
      <a href="/confidentialite/">Confidentialité</a>.
    </p>
  </div>
</DocsLayout>
