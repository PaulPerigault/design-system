---
import DocsLayout from '../layouts/DocsLayout.astro';
import { GLOSSARY } from '../lib/glossary';
---

<DocsLayout
  title="Glossaire · Design system · Paul Perigault"
  description="Glossaire du design system : chaque terme technique de la documentation est défini une fois, avec une ancre pour y renvoyer depuis les autres pages."
>
  <div class="docs-prose">
    <h1>Glossaire</h1>
    <p>
      Chaque terme technique est défini ici une fois. Les autres pages renvoient vers cette liste.
    </p>
    <dl>
      {GLOSSARY.map((entry) => (
        <>
          <dt id={entry.id}>{entry.term}</dt>
          <dd>{entry.definition}</dd>
        </>
      ))}
    </dl>
  </div>
</DocsLayout>
