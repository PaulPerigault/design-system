{
  "name": "ds-lead",
  "description": "Chef de lot autonome : découpe un lot en tâches, les fait exécuter et relire par le dispatcher, les intègre dans lot/<id> ; jamais de code ni de git en écriture.",
  "prompt": "file://../../prompts/lead.md",
  "model": "claude-opus-5.5",
  "tools": ["read", "write", "shell"],
  "resources": ["file://AGENTS.md"],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": ["**"],
        "effect": "allow",
        "exclude": ["**/.env*", "**/*.env", "**/.npmrc", "**/.secrets*"]
      },
      {
        "capability": "fs_read",
        "match": ["**/.env*", "**/*.env", "**/.npmrc", "**/.secrets*"],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "tasks/**",
          "docs/lots/**",
          "/Users/paulperigault/dev/design-system/.agents/lead-queue.md"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "packages/**",
          "apps/**",
          "tools/**",
          ".kiro/**",
          ".claude/**",
          ".github/**",
          "prompts/**",
          "docs/adr/**",
          "AGENTS.md",
          "CLAUDE.md",
          "**/package.json",
          "**/package-lock.json",
          "**/.env*",
          "**/*.env",
          "**/.npmrc",
          "**/.secrets*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git commit*",
          "git push*",
          "git merge*",
          "git rebase*",
          "git reset*",
          "git checkout*",
          "git switch*",
          "git branch*",
          "git stash*",
          "git worktree*",
          "git tag*",
          "git remote*",
          "git config*",
          "npm publish*",
          "npm * publish*",
          "pnpm *",
          "yarn *",
          "bun *",
          "npm install*",
          "npm i *",
          "npm uninstall*",
          "npm update*",
          "npx npm *",
          "curl *",
          "wget *",
          "ssh *",
          "scp *",
          "gh *",
          "kiro-cli *",
          "claude *",
          "tofu *",
          "terraform *",
          "wrangler *",
          "sudo *",
          "node -e*",
          "node --eval*",
          "node -p*",
          "rm *",
          "mv *",
          "cp *",
          "npm run infra*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "node tools/agents/run.mjs*",
          "node tools/agents/batch.mjs*",
          "node tools/agents/review.mjs*",
          "node tools/agents/integrate.mjs*",
          "npm run verify*",
          "npm run e2e*",
          "npm run build*",
          "npm test*",
          "npm run *",
          "npm -w *",
          "npx vitest*",
          "npx eslint*",
          "npx playwright*",
          "npx astro*",
          "npx tsc*",
          "npx prettier --check*",
          "node packages/guards/src/check-tokens.ts*",
          "git status*",
          "git diff*",
          "git log*",
          "git show*",
          "ls*",
          "cat *",
          "head *",
          "tail *",
          "grep *",
          "rg *",
          "find *",
          "wc *"
        ],
        "effect": "allow"
      },
      {
        "capability": "web_fetch",
        "match": ["*"],
        "effect": "deny"
      },
      {
        "capability": "web_search",
        "match": ["*"],
        "effect": "deny"
      },
      {
        "capability": "subagent",
        "match": ["*"],
        "effect": "allow"
      }
    ]
  },
  "hooks": [
    {
      "name": "ds-deny",
      "trigger": "PreToolUse",
      "matcher": "shell",
      "action": {
        "type": "command",
        "command": "node tools/agents/kiro-hook.mjs"
      },
      "timeout": 10
    }
  ]
}
