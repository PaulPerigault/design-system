{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "code-block",
  "type": "registry:ui",
  "title": "CodeBlock",
  "description": "Bloc de code coloré au build, défilable au clavier, avec bouton de copie révélé par un script externe.",
  "files": [
    {
      "path": "packages/astro/src/content/CodeBlock.astro",
      "type": "registry:ui"
    },
    {
      "path": "packages/astro/src/content/code-block.css",
      "type": "registry:ui"
    },
    {
      "path": "packages/astro/src/content/highlight.ts",
      "type": "registry:ui"
    },
    {
      "path": "packages/astro/src/behaviors/copy.ts",
      "type": "registry:ui"
    }
  ],
  "meta": {
    "tokens": [
      "--pp-color-accent",
      "--pp-color-control",
      "--pp-color-fg",
      "--pp-color-focus",
      "--pp-color-line",
      "--pp-color-muted",
      "--pp-color-status-degraded",
      "--pp-color-status-passed",
      "--pp-color-surface",
      "--pp-font-family-mono",
      "--pp-font-line-height-body",
      "--pp-font-size--1",
      "--pp-radius-control",
      "--pp-radius-surface",
      "--pp-size-focus-offset",
      "--pp-size-focus-width",
      "--pp-size-rule",
      "--pp-size-target-min",
      "--pp-space-2xs",
      "--pp-space-s",
      "--pp-space-xs"
    ],
    "version": "0.0.0"
  }
}
