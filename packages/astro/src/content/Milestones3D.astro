---
/**
 * Milestones3D : jalons le long d'un parcours. Le rendu serveur est la version complète : une
 * liste ordonnée (`<ol role="list">`), un `<li>` par jalon (date, groupe, libellé, statut écrit en
 * toutes lettres, lien), puis la cible finale. Lisible sans JavaScript, sans WebGL, indexable ; elle
 * n'est jamais retirée ni masquée. Le comportement externe (`behaviors/milestones-3d.ts`) y ajoute,
 * quand les conditions de l'ADR-0012 tiennent, une scène 3D (canvas `aria-hidden`) dans l'emplacement
 * `data-pp-stage`, fait de la liste le sélecteur et remplit le panneau de détail. L'emplacement suit
 * la liste : l'insérer au-dessus décalerait la liste déjà affichée (CLS mesuré par l'audit #366).
 * Le composant ne trie pas : l'ordre est celui de `milestones`. Données : bloc JSON non exécuté.
 */
import '@paulperigault/css/milestones-3d.css';
import {
  DEFAULT_LABELS,
  DEFAULT_LOCALE,
  dataBlock,
  formatDate,
  type MilestoneGoal,
  type MilestoneItem,
  type MilestoneLabels,
} from './milestones-3d-model';

interface Props {
  /** Jalons, dans l'ordre d'affichage (1 à 24 pour la scène 3D ; la liste n'a pas de plafond). */
  milestones: MilestoneItem[];
  /** Cible finale facultative, au bout du parcours. */
  goal?: MilestoneGoal;
  /** Nom accessible de la région (`aria-label`). Recommandé quand la page en porte plusieurs. */
  label?: string;
  /** Langue des dates (`Intl`). Défaut : `fr`. À passer avec la langue de la page. */
  locale?: string;
  /** Textes écrits par le composant (statuts, cible, lien, panneau). Défaut : français. */
  labels?: Partial<MilestoneLabels>;
  /** Réservé au placement du composant dans son parent. */
  class?: string;
}

const { milestones, goal, label, locale = DEFAULT_LOCALE, class: className } = Astro.props;
const text: MilestoneLabels = { ...DEFAULT_LABELS, ...Astro.props.labels };
const items = milestones.map((item) => ({
  ...item,
  when: item.date ? formatDate(item.date, locale) : undefined,
  state: item.status === 'achieved' ? text.achieved : text.planned,
}));
---

<section class:list={['pp-milestones', className]} aria-label={label} data-pp-milestones>
  <ol class="pp-milestones__list" role="list" data-pp-list>
    {items.map((item) => (
      <li class="pp-milestones__item" data-pp-item={item.id} data-status={item.status}>
        {item.when && (
          <time class="pp-milestones__date" datetime={item.when.datetime}>
            {item.when.text}
          </time>
        )}
        {item.group && <span class="pp-milestones__group">{item.group}</span>}
        <strong class="pp-milestones__name" data-pp-name>
          {item.label}
        </strong>
        <span class="pp-milestones__status">{item.state}</span>
        {item.href && (
          <a
            class="pp-milestones__link"
            href={item.href}
            aria-label={`${text.open} : ${item.label}`}
          >
            {text.open}
          </a>
        )}
      </li>
    ))}
  </ol>
  {goal && (
    <p class="pp-milestones__goal" data-pp-goal>
      <span class="pp-milestones__status">{text.goal}</span>
      {goal.href ? <a href={goal.href}>{goal.label}</a> : <strong>{goal.label}</strong>}
    </p>
  )}
  <div class="pp-milestones__stage" data-pp-stage aria-hidden="true"></div>
  <div
    class="pp-milestones__panel"
    data-pp-panel
    role="region"
    aria-label={text.panel}
    aria-live="polite"
    hidden
  ></div>
  <script is:inline type="application/json" data-pp-data set:html={dataBlock(milestones, goal)} />
</section>
