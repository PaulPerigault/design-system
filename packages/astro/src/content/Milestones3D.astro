---
/**
 * Milestones3D : un parcours de certifications ou de jalons, piloté au défilement quand la 3D est
 * admise (ADR-0013). Le rendu serveur est la version complète : liste ordonnée (`<ol role="list">`)
 * triée par date, objectif, panneau de détail de chaque jalon (masqué), lien d'évitement. Lisible
 * sans JavaScript ni WebGL, indexable ; la liste n'est jamais retirée. Le comportement externe
 * (`behaviors/milestones-3d.ts`) pose la scène dans `data-pp-stage`, fait de la liste le repère
 * d'étapes et affiche le panneau du jalon actif. L'emplacement de la scène ne s'insère qu'après un
 * geste quand la section est déjà à l'écran et que l'empreinte n'est pas réservée (`reserve`, ADR-0014 :
 * avec elle, la scène s'installe sans décalage). Données : bloc JSON non exécuté.
 */
import '@paulperigault/css/milestones-3d.css';
import Milestones3DDetail from './Milestones3DDetail.astro';
import Milestones3DItem from './Milestones3DItem.astro';
import { dataBlock } from './milestones-3d-data';
import { sortMilestones } from './milestones-3d-sort';
import {
  DEFAULT_LABELS,
  DEFAULT_LOCALE,
  formatDate,
  type MilestoneGoal,
  type MilestoneItem,
  type MilestoneLabels,
} from './milestones-3d-model';
import { GOAL_ID, endAnchor, type Step } from './milestones-3d-step';

interface Props {
  /** Jalons (1 à 24 pour la scène 3D). Triés par date croissante, tri stable. */
  milestones: MilestoneItem[];
  /** Objectif facultatif, au bout du parcours. */
  goal?: MilestoneGoal;
  /** Nom accessible de la région (`aria-label`). Recommandé quand la page en porte plusieurs. */
  label?: string;
  /** Langue des dates (`Intl`). Défaut : `fr`. À passer avec la langue de la page. */
  locale?: string;
  /** Mots de l'interface écrits par le composant. Défaut : français. */
  labels?: Partial<MilestoneLabels>;
  /** Identifiant de l'ancre qui suit la section (« Passer cette section »). Défaut : dérivé. */
  endId?: string;
  /**
   * Réserve dès le HTML serveur l'empreinte du mode amélioré (piste, cadre, bande d'étapes) : la
   * scène s'y installe sans décalage de mise en page. Défaut : oui. À mettre à `false` si la page
   * n'installe pas le comportement `milestones-3d` (sinon l'empreinte resterait vide).
   */
  reserve?: boolean;
  /** Réservé au placement du composant dans son parent. */
  class?: string;
}

const {
  milestones,
  goal,
  label,
  locale = DEFAULT_LOCALE,
  endId,
  reserve = true,
  class: className,
} = Astro.props;
const text: MilestoneLabels = { ...DEFAULT_LABELS, ...Astro.props.labels };
const sorted = sortMilestones(milestones);
const when = (date?: string) => (date ? formatDate(date, locale) : undefined);
const steps: Step[] = sorted.map((item) => ({
  ...item,
  when: when(item.date),
  state: item.status === 'achieved' ? text.achieved : text.planned,
}));
if (goal) {
  steps.push({ ...goal, id: GOAL_ID, status: 'goal', state: text.goal, when: when(goal.date) });
}
const end = endAnchor(endId, label ?? sorted[0]?.id ?? '');
---

<section
  class:list={['pp-milestones', className]}
  aria-label={label}
  data-pp-milestones
  data-reserve={reserve ? 'on' : undefined}
  data-pp-count={steps.length}
  data-pp-previous={text.previous}
  data-pp-next={text.next}
  data-pp-steps={text.steps}
  data-pp-progress={text.progress}
>
  <div class="pp-milestones__track" data-pp-track>
    <div class="pp-milestones__frame" data-pp-frame>
      <a class="pp-milestones__skip" href={`#${end}`}>
        {text.skip}
      </a>
      <div class="pp-milestones__stage" data-pp-stage aria-hidden="true"></div>
      <ol class="pp-milestones__list" role="list" data-pp-list>
        {steps.map((step) => (
          <Milestones3DItem step={step} text={text} />
        ))}
      </ol>
      <div class="pp-milestones__panel" data-pp-panel role="region" aria-label={text.panel} hidden>
        {steps.map((step) => (
          <Milestones3DDetail step={step} text={text} />
        ))}
      </div>
    </div>
  </div>
  <script is:inline type="application/json" data-pp-data set:html={dataBlock(sorted, goal)} />
  <div class="pp-milestones__end" id={end}></div>
</section>
