---
/**
 * Alert : message mis en avant, zéro JavaScript, ton par `data-tone` (CSP : aucun `style`).
 * La couleur de statut ne touche que l'icône (décorative) et le filet de début ; le ton est
 * écrit en clair (`toneLabel`) : jamais la couleur seule (WCAG 2.2, critère 1.4.1).
 * Sans `live`, aucun rôle (contenu statique) ; `polite` → `status`, `assertive` → `alert`.
 */
import './alert.css';

interface Props {
  /** Nature du message, écrite en clair dans le texte (la couleur n'est jamais seule). */
  tone?: 'info' | 'passed' | 'degraded' | 'failed';
  /** Libellé visible du ton (par exemple « Information »). */
  toneLabel: string;
  /** Titre court du message. */
  title?: string;
  /** Annonce par les lecteurs d'écran : `polite` attend la fin de la lecture, `assertive` interrompt. Absent : aucune annonce. */
  live?: 'polite' | 'assertive';
  /** Bordure de début : `start` (défaut) ou `none` (contour seul, sans filet de 4 px). */
  edge?: 'start' | 'none';
  /** Réservé au placement du composant dans son parent. */
  class?: string;
}

const CIRCLE = 'M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0';
const ICONS = {
  info: `${CIRCLE}M12 11v5M12 8h.01`,
  passed: `${CIRCLE}M8 12.5l3 3l5-6`,
  degraded: 'M12 3L22 20H2ZM12 10v4M12 17h.01',
  failed: `${CIRCLE}M9 9l6 6M15 9l-6 6`,
} as const;
const ROLES = { polite: 'status', assertive: 'alert' } as const;

const { tone = 'info', toneLabel, title, live, edge, class: className } = Astro.props;
const role = live === undefined ? undefined : ROLES[live];
---

<div
  class:list={['pp-alert', className]}
  data-tone={tone}
  data-edge={edge === 'none' ? 'none' : undefined}
  role={role}
>
  <svg
    class="pp-alert__icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d={ICONS[tone]}></path>
  </svg>
  <div class="pp-alert__body">
    <p class="pp-alert__heading">
      <span class="pp-alert__tone">{toneLabel}</span>
      {title && ' '}
      {title && <strong class="pp-alert__title">{title}</strong>}
    </p>
    <div class="pp-alert__content">
      <slot />
    </div>
  </div>
</div>
