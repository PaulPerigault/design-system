---
/**
 * ArtDirection : un recadrage par largeur d'écran (sujet resserré sur mobile) plutôt qu'une même
 * image réduite. `<picture>` écrit à la main : chaque `<source media>` porte les dimensions de
 * son recadrage (place réservée, CLS nul). Cadre `.pp-media` de `frame.css`, sans `data-ratio`.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { altOf, assertLocal, imagePath } from './checks';
import { dominantColor } from './dominant';
import { FORMATS, fallbackFormat, mediaFor, qualityFor, sizesFor, widthsFor } from './presets';
import type { ArtDirectionProps, Breakpoint } from './types';
import './frame.css';

type Props = ArtDirectionProps;

const { src, sources, priority = false, layout = 'page', kind = 'photo' } = Astro.props;
const { class: className } = Astro.props;

assertLocal(src);
for (const source of sources) assertLocal(source.src);
const alt = altOf(Astro.props);
const sizes = sizesFor(layout);
const quality = qualityFor(kind);
const ORDER: readonly Breakpoint[] = ['narrow', 'medium'];

const encode = (image: ImageMetadata, format: string) =>
  getImage({ src: image, widths: widthsFor(layout, image.width), format, quality });

const variants = async (image: ImageMetadata, media?: string) =>
  Promise.all(
    FORMATS.map(async (format) => ({
      media,
      type: `image/${format}`,
      srcset: (await encode(image, format)).srcSet.attribute,
      width: image.width,
      height: image.height,
    })),
  );

const ordered = [...sources].sort((a, b) => ORDER.indexOf(a.at) - ORDER.indexOf(b.at));
const directed = await Promise.all(
  ordered.map(({ at, src: image }) => variants(image, mediaFor(at))),
);
const rendered = [...directed.flat(), ...(await variants(src))];
const fallback = await encode(src, fallbackFormat(kind));
const path = imagePath(src);
const color = path === undefined ? undefined : await dominantColor(path);
const loading = priority
  ? ({ loading: 'eager', fetchpriority: 'high' } as const)
  : ({ loading: 'lazy', decoding: 'async' } as const);
---

<div class:list={['pp-media', className]} data-focal="center">
  {color && (
    <svg class="pp-media__placeholder" aria-hidden="true" focusable="false">
      <rect width="100%" height="100%" fill={color} />
    </svg>
  )}
  <picture>
    {rendered.map((source) => (
      <source {...source} sizes={sizes} />
    ))}
    <img
      src={fallback.src}
      srcset={fallback.srcSet.attribute}
      sizes={sizes}
      alt={alt}
      width={src.width}
      height={src.height}
      {...loading}
    />
  </picture>
</div>
