---
import { variants } from '../lib/variants';

/**
 * Button : `<button>` natif, ou `<a>` quand `href` est fourni (mêmes classes). Zéro JavaScript.
 * Aucun texte en dur : le libellé vient du slot. Variantes par classe (CSP stricte : pas de `style`).
 * Un lien désactivé perd son `href` et porte `role="link"` + `aria-disabled="true"`.
 */
interface Props {
  tone?: 'primary' | 'secondary' | 'quiet';
  size?: 'm' | 'l';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  href?: string;
  class?: string;
}

const button = variants({
  base: 'pp-button',
  variants: {
    tone: {
      primary: 'pp-button--primary',
      secondary: 'pp-button--secondary',
      quiet: 'pp-button--quiet',
    },
    size: { m: 'pp-button--m', l: 'pp-button--l' },
  },
  defaults: { tone: 'primary', size: 'm' },
});

const { tone, size, type = 'button', disabled = false, href, class: className } = Astro.props;
const classes = [button({ tone, size }), className].filter(Boolean).join(' ');
const isLink = href !== undefined;
---

{isLink ? (
  <a
    class={classes}
    href={disabled ? undefined : href}
    role={disabled ? 'link' : undefined}
    aria-disabled={disabled ? 'true' : undefined}
  >
    <slot />
  </a>
) : (
  <button class={classes} type={type} disabled={disabled}>
    <slot />
  </button>
)}

<style>
  .pp-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-block-size: var(--pp-size-control-height);
    min-inline-size: var(--pp-size-target-min);
    padding-inline: var(--pp-space-s);
    border: var(--pp-size-rule) solid transparent;
    border-radius: var(--pp-radius-control);
    font-family: inherit;
    font-size: var(--pp-font-size-0);
    font-weight: var(--pp-font-weight-medium);
    line-height: var(--pp-font-line-height-heading);
    text-decoration: none;
    cursor: pointer;
    transition:
      color var(--pp-duration-fast) var(--pp-easing-standard),
      background-color var(--pp-duration-fast) var(--pp-easing-standard),
      border-color var(--pp-duration-fast) var(--pp-easing-standard);
  }

  .pp-button--l {
    padding-inline: var(--pp-space-m);
    font-size: var(--pp-font-size-1);
  }

  .pp-button--primary {
    background-color: var(--pp-color-accent);
    color: var(--pp-color-on-accent);
  }

  .pp-button--secondary {
    background-color: transparent;
    border-color: var(--pp-color-control);
    color: var(--pp-color-fg);
  }

  .pp-button--secondary:hover {
    border-color: var(--pp-color-fg);
  }

  .pp-button--quiet {
    background-color: transparent;
    color: var(--pp-color-fg);
    text-decoration: underline;
  }

  .pp-button--quiet:hover {
    color: var(--pp-color-accent);
  }

  .pp-button:disabled,
  .pp-button[aria-disabled='true'] {
    background-color: transparent;
    border-color: var(--pp-color-control);
    color: var(--pp-color-muted);
    cursor: not-allowed;
  }

  @media (forced-colors: active) {
    .pp-button--primary {
      border-color: ButtonText;
    }
  }
</style>
