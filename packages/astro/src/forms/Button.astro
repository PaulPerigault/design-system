---
import './button.css';
import { button } from './button-variants';

/**
 * Button : `<button>` natif, ou `<a>` quand `href` est fourni (mêmes classes). Zéro JavaScript.
 * Aucun texte en dur : le libellé vient du slot. Variantes par classe (CSP stricte : pas de `style`).
 * Un lien désactivé perd son `href` et porte `role="link"` + `aria-disabled="true"`.
 */
interface Props {
  /** Importance de l'action (défaut `primary`, l'action principale, une par vue). */
  tone?: 'primary' | 'secondary' | 'quiet';
  /** Taille (défaut `m`) ; les deux respectent la cible de 44 px. */
  size?: 'm' | 'l';
  /** Type du bouton ; `submit` seulement dans un formulaire. */
  type?: 'button' | 'submit' | 'reset';
  /** Désactive le bouton (ou le lien, rendu `aria-disabled`). */
  disabled?: boolean;
  /** Rend un lien `<a>` stylé en bouton au lieu d'un `<button>` : pour naviguer, pas pour agir. */
  href?: string;
  /** Pleine largeur, libellé centré (défaut `false`) : pour un panneau étroit. */
  block?: boolean;
  /** Réservé au placement du composant dans son parent. */
  class?: string;
}

const {
  tone,
  size,
  type = 'button',
  disabled = false,
  href,
  block,
  class: className,
} = Astro.props;
const classes = [button({ tone, size }), block ? 'pp-button--block' : '', className]
  .filter(Boolean)
  .join(' ');
const isLink = href !== undefined;
---

{isLink ? (
  <a
    class={classes}
    href={disabled ? undefined : href}
    role={disabled ? 'link' : undefined}
    aria-disabled={disabled ? 'true' : undefined}
  >
    <slot />
  </a>
) : (
  <button class={classes} type={type} disabled={disabled}>
    <slot />
  </button>
)}
