---
/**
 * Input : champ de saisie natif sur une ligne. Zéro JavaScript ; l'état d'erreur passe par
 * `aria-invalid` (annoncé par les lecteurs d'écran) et `:user-invalid` (validation native).
 * Le libellé, le message d'aide et le message d'erreur sont fournis par le site (`<label for>`,
 * `describedBy`) : le composant n'embarque aucun texte. Le focus vient de `@paulperigault/css`.
 */
interface Props {
  /** Identifiant, visé par `<label for>`. */
  id: string;
  /** Nom envoyé avec le formulaire. */
  name: string;
  /** Type de saisie ; choisit aussi le clavier virtuel sur mobile. */
  type?: 'text' | 'email' | 'url' | 'tel' | 'search' | 'password' | 'number';
  /** Valeur initiale. */
  value?: string | number;
  /** Saisie obligatoire (`required`). */
  required?: boolean;
  /** Désactive le champ. */
  disabled?: boolean;
  /** Jeton `autocomplete` (WCAG 1.3.5), par exemple `email` ou `name`. */
  autocomplete?: string;
  /** Clavier virtuel à afficher quand `type` ne suffit pas. */
  inputmode?: 'none' | 'text' | 'tel' | 'url' | 'email' | 'numeric' | 'decimal' | 'search';
  /** Libellé de la touche Entrée du clavier virtuel (`enterkeyhint`), par exemple `next`. */
  enterkeyhint?: 'enter' | 'done' | 'go' | 'next' | 'previous' | 'search' | 'send';
  /** Identifiants (séparés par des espaces) des éléments d'aide ou d'erreur. */
  describedBy?: string | undefined;
  /** Pose `aria-invalid="true"` ; à relier au message d'erreur par `describedBy`. */
  invalid?: boolean | undefined;
  /** Exemple de saisie ; jamais à la place du libellé. */
  placeholder?: string;
  /** Réservé au placement du composant dans son parent. */
  class?: string;
}

const {
  id,
  name,
  type = 'text',
  value,
  required = false,
  disabled = false,
  autocomplete,
  inputmode,
  enterkeyhint,
  describedBy,
  invalid = false,
  placeholder,
  class: className,
} = Astro.props;
---

<input
  class:list={['pp-input', className]}
  id={id}
  name={name}
  type={type}
  value={value}
  required={required}
  disabled={disabled}
  autocomplete={autocomplete}
  inputmode={inputmode}
  enterkeyhint={enterkeyhint}
  aria-describedby={describedBy}
  aria-invalid={invalid ? 'true' : undefined}
  placeholder={placeholder}
/>

<style>
  .pp-input {
    box-sizing: border-box;
    inline-size: 100%;
    min-block-size: max(var(--pp-size-control-height), var(--pp-size-target-min));
    padding-block: var(--pp-space-3xs);
    padding-inline: var(--pp-space-xs);
    border: var(--pp-size-rule) solid var(--pp-color-control);
    border-radius: var(--pp-radius-control);
    background-color: var(--pp-color-bg);
    color: var(--pp-color-fg);
    font: inherit;
    font-size: var(--pp-font-size-0);
    line-height: var(--pp-font-line-height-body);
  }

  .pp-input::placeholder {
    color: var(--pp-color-muted);
    opacity: 1;
  }

  .pp-input[aria-invalid='true'],
  .pp-input:user-invalid {
    border-color: var(--pp-color-status-failed);
  }

  .pp-input:disabled {
    background-color: var(--pp-color-surface);
    color: var(--pp-color-muted);
    cursor: not-allowed;
  }
</style>
