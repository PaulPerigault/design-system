---
/**
 * Center : centre un bloc dans l'axe inline, à largeur de lecture (modèle « Every Layout »,
 * Pickering et Bell). Zéro JavaScript ; variantes par `data-*` (CSP stricte : aucun `style`).
 */
interface Props {
  /** Centre aussi le texte. */
  text?: boolean;
  /** Centre les enfants selon leur largeur propre. */
  intrinsic?: boolean;
  /** Marge intérieure en ligne, pour que le contenu ne touche pas les bords sur mobile. */
  gutter?: 's' | 'm';
  /** Élément HTML rendu (sémantique de la page). */
  as?: 'div' | 'section' | 'article' | 'main' | 'header' | 'footer';
  /** Réservé au placement du composant dans son parent. */
  class?: string;
}

const { text = false, intrinsic = false, gutter, as: Tag = 'div', class: className } = Astro.props;
---

<Tag
  class:list={['pp-center', className]}
  data-text={text ? '' : undefined}
  data-intrinsic={intrinsic ? '' : undefined}
  data-gutter={gutter}
>
  <slot />
</Tag>

<style>
  .pp-center {
    box-sizing: content-box;
    margin-inline: auto;
    max-inline-size: var(--pp-size-measure);
  }

  .pp-center[data-text] {
    text-align: center;
  }

  .pp-center[data-intrinsic] {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pp-center[data-gutter='s'] {
    padding-inline: var(--pp-space-s);
  }

  .pp-center[data-gutter='m'] {
    padding-inline: var(--pp-space-m);
  }

  .pp-center > :global(*) {
    max-inline-size: 100%;
  }
</style>
