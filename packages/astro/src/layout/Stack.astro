---
/**
 * Stack : empile ses enfants dans l'axe de bloc avec un espacement régulier entre eux,
 * sans marge avant le premier ni après le dernier (modèle « Every Layout », Pickering et Bell).
 * Zéro JavaScript ; l'espacement passe par `data-space` (CSP stricte : aucun `style` en ligne).
 */
interface Props {
  space?: 'xs' | 's' | 'm' | 'l' | 'xl';
  /** Élément rendu. Avec `ul` ou `ol`, les enfants doivent être des `<li>`. */
  as?: 'div' | 'section' | 'ul' | 'ol' | 'article';
  /** Réservé au placement du composant dans son parent. */
  class?: string;
}

const { space = 'm', as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['pp-stack', className]} data-space={space}>
  <slot />
</Tag>

<style>
  .pp-stack {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .pp-stack[data-space='xs'] {
    --stack-space: var(--pp-space-xs);
  }

  .pp-stack[data-space='s'] {
    --stack-space: var(--pp-space-s);
  }

  .pp-stack[data-space='m'] {
    --stack-space: var(--pp-space-m);
  }

  .pp-stack[data-space='l'] {
    --stack-space: var(--pp-space-l);
  }

  .pp-stack[data-space='xl'] {
    --stack-space: var(--pp-space-xl);
  }

  .pp-stack > :global(*) {
    margin-block: 0;
  }

  .pp-stack > :global(* + *) {
    margin-block-start: var(--stack-space);
  }
</style>
