---
/**
 * LineChart : courbe d'une ou plusieurs séries, SVG statique généré au build. Zéro JavaScript,
 * aucun attribut `style` (CSP stricte). La géométrie vient de `@paulperigault/dataviz` : ce
 * composant ne fait que poser des éléments. Le jeu de données est validé à la frontière ; une
 * donnée invalide fait échouer le build avec le code d'erreur. La couleur ne porte jamais seule
 * une série : chaque rang a aussi un motif de trait et un marqueur (WCAG 1.4.1). Une série de
 * plus de 500 points est sous-échantillonnée par LTTB ; le tableau lié garde la donnée complète.
 */
import './chart-base.css';
import './chart-series.css';
import './line-chart.css';
import './line-chart-series.css';
import { lineAxes } from './chart/axes.ts';
import ChartAxes from './chart/ChartAxes.astro';
import ChartFrame from './chart/ChartFrame.astro';
import ChartLegend from './chart/ChartLegend.astro';
import { prepareLine } from './chart/prepare.ts';
import type { ChartProps } from './chart/props.ts';
import { DEFAULT_LABELS, assertChartId } from './chart/props.ts';
import { lineSwatch } from './chart/swatch.ts';
import { describe } from './chart/summary.ts';

type Props = ChartProps;

const BLOCK = 'pp-line-chart';
const { id, title, dataset, locale = 'fr', class: className, ...texts } = Astro.props;
const labels = {
  table: texts.tableLabel ?? DEFAULT_LABELS.table,
  empty: texts.emptyLabel ?? DEFAULT_LABELS.empty,
  error: texts.errorLabel ?? DEFAULT_LABELS.error,
};

assertChartId(id, 'LineChart');
const prepared = prepareLine(dataset, locale, `LineChart « ${title} »`);
const { model } = prepared;
const description = describe(prepared.dataset, prepared.summary, model?.offZero ?? false);
const swatches = (model?.series ?? []).map((s) => lineSwatch(s.index, s.label));
---

<ChartFrame
  block={BLOCK}
  id={id}
  title={title}
  description={description}
  prepared={prepared}
  labels={labels}
  class={className}
>
  {model && <ChartAxes block={BLOCK} axes={lineAxes(model)} />}
  {model?.series.map((s) => (
    <g data-series={s.index + 1}>
      <path class="pp-line-chart__line" d={s.d}></path>
      <path class="pp-line-chart__marker" d={s.markers}></path>
    </g>
  ))}
  <ChartLegend slot="legend" block={BLOCK} series={swatches} />
</ChartFrame>
