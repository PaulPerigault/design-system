---
/** Grille, axe de référence, graduations et unité d'un graphique : éléments SVG sans calcul. */
import type { AxesModel } from './axes.ts';

interface Props {
  /** Bloc de classes du graphique : `pp-line-chart`, `pp-bar-chart`. */
  block: string;
  axes: AxesModel;
}

const { block, axes } = Astro.props;
---

<path class={`${block}__grid`} d={axes.grid}></path>
<path class={`${block}__axis`} d={axes.axis}></path>
{axes.ticks.map((tick) => (
  <text
    class={`${block}__tick`}
    data-axis={tick.axis}
    data-align={tick.align}
    x={tick.x}
    y={tick.y}
  >
    {tick.label}
  </text>
))}
