---
/** Légende : trait, marqueur et libellé de chaque série (la couleur ne porte jamais seule). */
import { SWATCH } from './frame.ts';
import type { SeriesModel } from './line-series.ts';
import { markerPath } from './markers.ts';

interface Props {
  series: readonly SeriesModel[];
}

const { series } = Astro.props;
---

<ul class="pp-line-chart__legend" role="list">
  {series.map((s) => (
    <li>
      <svg
        class="pp-line-chart__swatch"
        viewBox={`0 0 ${SWATCH.width} ${SWATCH.height}`}
        data-series={s.index + 1}
        aria-hidden="true"
        focusable="false"
      >
        <path class="pp-line-chart__line" d={`M0 ${SWATCH.midY}H${SWATCH.width}`}></path>
        <path
          class="pp-line-chart__marker"
          d={markerPath(s.index, SWATCH.midX, SWATCH.midY)}
        ></path>
      </svg>
      <span>{s.label}</span>
    </li>
  ))}
</ul>
