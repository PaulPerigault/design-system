---
/** Motifs de remplissage des séries : un par rang, ids propres au graphique. */
import { PATTERN_MARKS, TILE, patternId } from './bar-patterns.ts';

interface Props {
  id: string;
  /** Nombre de séries du graphique : seuls leurs motifs sont écrits. */
  count: number;
  /** Bloc de classes du graphique (`pp-bar-chart` par défaut). */
  block?: string;
  /** Teinte imposée par rang (zones d'une jauge) ; sinon la couleur du rang. */
  tones?: readonly (string | undefined)[];
}

const { id, count, block = 'pp-bar-chart', tones = [] } = Astro.props;
---

<defs>
  {PATTERN_MARKS.slice(0, count).map((mark, index) => (
    <pattern
      id={patternId(id, index)}
      data-series={index + 1}
      data-tone={tones[index]}
      width={TILE}
      height={TILE}
      patternUnits="userSpaceOnUse"
    >
      <rect class={`${block}__tile`} width={TILE} height={TILE}></rect>
      {mark !== '' && <path class={`${block}__mark`} d={mark}></path>}
    </pattern>
  ))}
</defs>
