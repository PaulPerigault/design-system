{
  "name": "@paulperigault/guards",
  "version": "0.0.0",
  "description": "Garde-fous de conception : tailles, couleurs, couches, tokens, images, config ESLint.",
  "type": "module",
  "license": "MIT",
  "author": "Paul Perigault",
  "keywords": [
    "eslint",
    "lint",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulPerigault/design-system.git",
    "directory": "packages/guards"
  },
  "homepage": "https://design.paulperigault.dev",
  "bugs": "https://github.com/PaulPerigault/design-system/issues",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "node ../../tools/checks/check-publish-env.mjs",
    "test": "vitest run"
  },
  "bin": {
    "pp-guards": "./dist/bin.js"
  },
  "exports": {
    "./design": {
      "types": "./dist/design/rules.d.ts",
      "development": "./src/design/rules.ts",
      "default": "./dist/design/rules.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "development": "./src/eslint.ts",
      "default": "./dist/eslint.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "typescript-eslint": "^8.71.2"
  },
  "peerDependenciesMeta": {
    "typescript-eslint": {
      "optional": true
    }
  }
}
