{
  "name": "@paulperigault/dataviz",
  "version": "0.0.0",
  "description": "Contrat de données, formatage fr et palettes accessibles dérivées de l'accent, pour les graphiques statiques.",
  "type": "module",
  "license": "MIT",
  "author": "Paul Perigault",
  "keywords": [
    "dataviz",
    "oklch",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulPerigault/design-system.git",
    "directory": "packages/dataviz"
  },
  "homepage": "https://design.paulperigault.dev",
  "bugs": "https://github.com/PaulPerigault/design-system/issues",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "node ../../tools/checks/check-publish-env.mjs",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@paulperigault/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@paulperigault/tokens": "0.0.0"
  }
}
