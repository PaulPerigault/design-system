{
  "name": "@paulperigault/tokens",
  "version": "1.0.0",
  "description": "Design tokens DTCG 2025.10 de paulperigault.fr : CSS, JSON et types générés ; couleur et contraste.",
  "type": "module",
  "license": "MIT",
  "author": "Paul Perigault",
  "keywords": [
    "design-tokens",
    "dtcg",
    "oklch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulPerigault/design-system.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://design.paulperigault.dev",
  "bugs": "https://github.com/PaulPerigault/design-system/issues",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "generated",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "node ../../tools/checks/check-publish-env.mjs",
    "build": "node scripts/build.ts && node --eval \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "node scripts/build.ts --check",
    "prepack": "npm run build"
  },
  "exports": {
    "./color": {
      "@paulperigault/source": "./src/lib/color.ts",
      "types": "./dist/lib/color.d.ts",
      "default": "./dist/lib/color.js"
    },
    "./contrast": {
      "@paulperigault/source": "./src/lib/contrast.ts",
      "types": "./dist/lib/contrast.d.ts",
      "default": "./dist/lib/contrast.js"
    },
    "./customize": {
      "@paulperigault/source": "./src/customize/index.ts",
      "types": "./dist/customize/index.d.ts",
      "default": "./dist/customize/index.js"
    },
    "./palette": {
      "@paulperigault/source": "./src/palette/index.ts",
      "types": "./dist/palette/index.d.ts",
      "default": "./dist/palette/index.js"
    },
    "./tokens.css": "./generated/tokens.css",
    "./tokens.json": "./generated/tokens.json",
    "./types": "./generated/tokens.d.ts",
    "./package.json": "./package.json"
  }
}
