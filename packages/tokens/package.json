{
  "name": "@paulperigault/tokens",
  "version": "0.0.0",
  "description": "Design tokens DTCG 2025.10 de paulperigault.fr : CSS, JSON et types générés ; couleur et contraste.",
  "type": "module",
  "license": "MIT",
  "author": "Paul Perigault",
  "keywords": [
    "design-tokens",
    "dtcg",
    "oklch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulPerigault/design-system.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://ds.paulperigault.dev",
  "bugs": "https://github.com/PaulPerigault/design-system/issues",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "src",
    "generated",
    "scripts",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "node ../../tools/checks/check-publish-env.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check"
  },
  "exports": {
    "./color": {
      "types": "./src/lib/color.d.mts",
      "default": "./src/lib/color.mjs"
    },
    "./contrast": {
      "types": "./src/lib/contrast.d.mts",
      "default": "./src/lib/contrast.mjs"
    },
    "./tokens.css": "./generated/tokens.css",
    "./tokens.json": "./generated/tokens.json",
    "./types": "./generated/tokens.d.ts",
    "./package.json": "./package.json"
  }
}
