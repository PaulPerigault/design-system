{
  "name": "@paulperigault/milestones-3d",
  "version": "0.2.0",
  "description": "Scène 3D de jalons en WebGL2 : pp-milestones compilé en WebAssembly, enveloppe TypeScript stricte, amélioration progressive.",
  "type": "module",
  "license": "MIT",
  "author": "Paul Perigault",
  "keywords": [
    "webgl2",
    "wasm",
    "milestones",
    "progressive-enhancement"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulPerigault/design-system.git",
    "directory": "packages/milestones-3d"
  },
  "homepage": "https://design.paulperigault.dev",
  "bugs": "https://github.com/PaulPerigault/design-system/issues",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "wasm",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json --declaration false --removeComments && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:wasm": "node ../../tools/wasm/build-milestones.ts",
    "check:wasm": "node scripts/check-wasm.ts",
    "prepack": "npm run build",
    "prepublishOnly": "node ../../tools/checks/check-publish-env.mjs && node scripts/check-wasm.ts",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@paulperigault/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
