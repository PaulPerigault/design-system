{
  "name": "paulperigault-design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo du design system de paulperigault.fr",
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:size": "node tools/checks/check-size.mjs",
    "check:readability": "node tools/checks/check-readability.mjs",
    "check:install-scripts": "node tools/checks/check-install-scripts.mjs",
    "check:security-txt": "node tools/checks/check-security-txt.mjs",
    "check:lockfile": "node tools/checks/check-lockfile.mjs",
    "check:secrets": "secretlint \"**/*\"",
    "check:pack": "npm pack --dry-run --workspaces --json > /dev/null",
    "guard": "npm run check:secrets && npm run check:size && npm run check:lockfile && npm run check:guards && npm run check:tokens && npm run check:registry && npm run check:install-scripts && npm run check:security-txt && npm run check:readability",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run guard && npm run lint && npm run format:check && npm test && npm run build && npm run check:mcp-data && npm -w @paulperigault/docs run check && npm run check:pack",
    "agents:run": "node tools/agents/run.mjs",
    "agents:batch": "node tools/agents/batch.mjs",
    "prepare": "husky",
    "check:tokens": "npm -w @paulperigault/tokens run check && node packages/guards/src/check-tokens.ts --tokens packages/tokens/generated/tokens.json packages/css/src packages/astro/src apps/docs/src",
    "e2e": "playwright test -c apps/docs/playwright.config.ts",
    "check:guards": "node packages/guards/src/bin.ts all --config pp-guards.config.json",
    "registry": "node tools/registry/build.mjs",
    "check:registry": "node tools/registry/build.mjs --check",
    "check:mcp-data": "npm -w @paulperigault/mcp run check:data"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "secretlint": "^13.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,mjs,astro}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
