  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/guards/guard-npm-publish.mjs"],
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/guards/guard-pr-merge.mjs"],
            "onFailure": "block",
            "timeout": 30
          }
        ]
      }
    ]
